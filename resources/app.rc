#include "../include/ticket_ocr/resource.h"
#include <winresrc.h>

IDI_APP_ICON ICON "../assets/icons/ticket_ocr.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TicketOCR Studio"
            VALUE "FileDescription", "TicketOCR Studio - Error Screenshot OCR & ITSM Ticket Generator"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ticket_ocr"
            VALUE "OriginalFilename", "ticket_ocr_gui.exe"
            VALUE "ProductName", "TicketOCR Studio"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
